{
  "name": "website-visit-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "VISIT_LIMITER",
      "namespace_id": "741361",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visits",
      "database_id": "f7903354-ed45-4ad9-85bc-3ef9c02a3baa"
    }
  ]
}
